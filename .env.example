# ─────────────────────────────────────────────────────────────
# Zentory Protocol — Frontend Environment Variables
# Copy to .env.local and fill in values
# DO NOT commit .env.local — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Use ONE of these. The code supports either name.
# Treat this key as fully public: it is inlined into the browser bundle. RLS
# grants it SELECT on public-display tables and nothing else.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# Service-role key — REQUIRED. Since the RLS lockdown (audit #21) no table has
# an insert/update policy, so every server-side write (waitlist signups,
# /api/research/*, /api/contribute/*, the heartbeat cron) needs this key.
# NEVER prefix with NEXT_PUBLIC_ — it bypasses RLS entirely.
# SUPABASE_SERVICE_ROLE_KEY= (do not commit)

# ── Blockchain ────────────────────────────────────────────────
# HyperEVM testnet RPC (free, no key required)
NEXT_PUBLIC_HYPEREVM_RPC=https://rpc.hyperliquid-testnet.xyz/evm

# ── WalletConnect ─────────────────────────────────────────────
# Required for WalletConnect v2 support in wagmi
# Get free project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ── Sentry (optional, for error tracking) ─────────────────────
# Get from: https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN= (do not commit)

# ── Signal Registry (optional) ───────────────────────────────
# NEXT_PUBLIC_SIGNAL_REGISTRY= (do not commit)

# ── Epoch Scoring (optional) ─────────────────────────────────
# NEXT_PUBLIC_EPOCH_SCORING= (do not commit)

# ── Subscription Vault (optional) ────────────────────────────
# NEXT_PUBLIC_SUBSCRIPTION_VAULT= (do not commit)

# ── Keeper (Server-side only — DO NOT expose to client!) ─────
# Private key for the keeper wallet that executes on-chain trades.
# NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only.
# KEEPER_PRIVATE_KEY= (do not commit)

# ── Keeper API Key (optional, for protected API routes) ────────
# If set, `/api/signals/execute` requires:
#   Authorization: Bearer <KEEPER_API_KEY>
# KEEPER_API_KEY= (do not commit)

# ── Discord Webhook (optional, for alerts) ────────────────────
# DISCORD_WEBHOOK_URL= (do not commit)

# ── Cron (server-side only) ───────────────────────────────────
# CRON_SECRET= (do not commit)

# ── Upstash Redis (optional, for rate limiting/caching) ──────
# UPSTASH_REDIS_REST_URL= (do not commit)
# UPSTASH_REDIS_REST_TOKEN= (do not commit)

# ── Hyperliquid (Terminal — gate to live order routing) ──────────────
# The /trade page reads three vars from lib/hyperliquid.ts. Until they are set
# the page stays in read-only mode (order book, mids, your positions render;
# the "Approve" button and order submit are disabled). Setting NEXT_PUBLIC_HL_BUILDER_ADDRESS
# is the ONLY switch that flips /trade from read-only to live, fee-earning order
# routing. Runtime verification plan + step-by-step script:
#   docs/TRADE_RUNTIME_VERIFICATION.md
#
# Zentory builder wallet. Must hold >= 100 USDC on Hyperliquid to collect fees
# (a Hyperliquid protocol requirement). When set, HL_LIVE_ORDERS in
# lib/hyperliquid.ts:19 becomes truthy and /trade enables the "Approve" button
# + order submit. When unset, the page stays in read-only mode regardless of
# NEXT_PUBLIC_HL_API below.
# NEXT_PUBLIC_HL_BUILDER_ADDRESS=0xYourBuilder...
#
# Builder fee in TENTHS of a basis point. f=10 => 1bp; cap is 100 (=10bps) for
# perps, 1000 (=100bps=1%) for spot. 10 (=1bp) is a sane, competitive default.
NEXT_PUBLIC_HL_BUILDER_FEE=10
#
# Hyperliquid REST API endpoint.
#   https://api.hyperliquid-testnet.xyz — testnet (use during verification)
#   https://api.hyperliquid.xyz          — mainnet (default below)
# Default is mainnet but live order routing is GATED on NEXT_PUBLIC_HL_BUILDER_ADDRESS
# being set, so a missing HL_BUILDER keeps /trade safe even on the mainnet URL.
NEXT_PUBLIC_HL_API=https://api.hyperliquid.xyz
